# ---- Database (Supabase Postgres) ----
# DATABASE_URL = used by the app.  DIRECT_URL = used by "prisma migrate".
# If the direct host does not connect from your network (IPv6 only), replace BOTH
# with the "Session pooler" string from Supabase > Connect (see README, Troubleshooting).
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres"

# ---- Supabase (used only as hosting for Postgres; auth is our own JWT) ----
SUPABASE_URL=https://fuhwokakmffzppnjnuop.supabase.co
SUPABASE_SERVICE_ROLE_KEY=[INSERT_YOUR_SERVICE_ROLE_KEY_HERE]

# ---- Auth ----
JWT_SECRET=change_me_to_a_long_random_string

# ---- Cloudinary (image uploads) ----
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ---- App ----
PORT=4000
NODE_ENV=development
# Domain the schools live under: abc.<ROOT_DOMAIN>. Use "localhost" on your PC, "sncmt.com" in production.
ROOT_DOMAIN=localhost

# First platform admin, created automatically on first start. CHANGE THE PASSWORD.
PLATFORM_ADMIN_EMAIL=admin@sncmt.com
PLATFORM_ADMIN_PASSWORD=ChangeMe-12345
PLATFORM_ADMIN_NAME=Platform Admin
